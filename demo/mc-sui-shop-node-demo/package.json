{
  "name": "mc-sui-shop-node-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Pure Node.js / Express + Vite demo serving a semantic-ui product list as plain JSON — no Java backend.",
  "scripts": {
    "predev": "npm run check-client",
    "dev": "tsx watch --ignore \"**/*.timestamp-*.mjs\" src/server.ts",
    "prebuild": "npm run check-client",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "tsx src/server.ts --prod",
    "typecheck": "tsc --noEmit",
    "check-client": "node scripts/check-client.mjs"
  },
  "dependencies": {
    "@mindconnect-ai/mc-semantic-ui-core": "file:../../core/mc-semantic-ui-core",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
