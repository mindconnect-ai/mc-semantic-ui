{
  "name": "@mindconnect-ai/mc-semantic-ui-ext-calendar",
  "version": "0.3.5-SNAPSHOT",
  "description": "Kanban extension for mc-semantic-ui \u2014 adds the `kanban` node type: a board of lanes whose cards are dragged between them",
  "keywords": [
    "mc-semantic-ui",
    "server-driven-ui",
    "calendar"
  ],
  "homepage": "https://github.com/mindconnect-ai/mc-semantic-ui",
  "bugs": "https://github.com/mindconnect-ai/mc-semantic-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindconnect-ai/mc-semantic-ui.git",
    "directory": "ext/mc-semantic-ui-ext-calendar"
  },
  "license": "Apache-2.0",
  "author": "David Beisert <beisdog@web.de>",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/calendar/extension.d.ts",
  "main": "./dist/calendar/extension.js",
  "exports": {
    ".": {
      "types": "./dist/calendar/extension.d.ts",
      "default": "./dist/calendar/extension.js"
    },
    "./package.json": "./package.json",
    "./calendar.css": "./dist/calendar/calendar.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/build-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/test/ts/*.test.mjs"
  },
  "peerDependencies": {
    "@mindconnect-ai/mc-semantic-ui-core": "0.3.5-SNAPSHOT"
  },
  "devDependencies": {
    "@mindconnect-ai/mc-semantic-ui-core": "file:../../core/mc-semantic-ui-core",
    "typescript": "^5.4.0"
  }
}
