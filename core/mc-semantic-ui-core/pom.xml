<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.mindconnect</groupId>
        <artifactId>mc-semantic-ui-parent</artifactId>
        <version>0.2.3-SNAPSHOT</version>
        <relativePath>../../parents/mc-semantic-ui-parent/pom.xml</relativePath>
    </parent>

    <artifactId>mc-semantic-ui-core</artifactId>
    <packaging>jar</packaging>
    <name>Semantic UI :: Core</name>
    <!-- Set explicitly: Maven would otherwise append the module path to the
         parent's url, and flatten-maven-plugin ignores the
         child.project.url.inherit.append.path=false that suppresses it —
         the published pom would carry a 404. -->
    <url>https://github.com/mindconnect-ai/mc-semantic-ui</url>

    <!-- Opt in to Maven Central publishing; see the parent's release profile. -->
    <properties>
        <sui.publish.skip>false</sui.publish.skip>
    </properties>
    <description>Semantic UI core — model classes and default TypeScript renderer in one module</description>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Server-Side Rendering (optional). handlebars.java powers the
            SuiServerRenderer; spring-boot-autoconfigure wires the content-
            negotiation handler. Both are optional so pure-SPA consumers
            (JSON + the TS renderer) don't pull them in. SSR activates only
            when the consumer has them on the classpath AND sets
            mindconnect.sui.ssr.enabled=true.
        -->
        <dependency>
            <groupId>com.github.jknack</groupId>
            <artifactId>handlebars</artifactId>
            <version>${handlebars.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Run the TypeScript compile alongside javac. The TS sources live
                under src/main/ts/ and emit into target/ts-dist/; `npm run
                build` then assembles dist/ from that plus the stylesheets and
                the icon sprite, and the resources-plugin below folds dist/ into
                the JAR under META-INF/resources/sui/ so any Spring-Boot
                consumer picks it up automatically as static resources
                at /sui/*.
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals><goal>install-node-and-npm</goal></goals>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals><goal>npm</goal></goals>
                        <phase>compile</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                    <!--
                        The TypeScript tests, which until now ran only when
                        somebody remembered to. They are node:test files
                        against the compiled output in target/ts-dist, so they
                        need no browser, no jsdom and no new dependency — just
                        the Node this plugin already installs.

                        Skipped by -DskipTests along with everything else, so
                        `mvn install -DskipTests` still means what it says.
                    -->
                    <execution>
                        <id>npm-test</id>
                        <goals><goal>npm</goal></goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>test</arguments>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Pack the client into the JAR so consumers get it for free: it
                lands under META-INF/resources/sui/* and Spring Boot serves it
                at /sui/*.

                The source is dist/, assembled by scripts/build-dist.mjs during
                `npm run build` above — the very folder published to npm. One
                script decides what "the client" is, so the JAR and the npm
                tarball cannot drift apart.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-static-assets</id>
                        <phase>process-classes</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources/sui</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>dist</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                dist/ sits outside target/ because npm's "files" and "exports"
                have to name a path a consumer can read, and nobody expects a
                package to publish out of target/. `mvn clean` should still
                mean what it says, so it is cleaned explicitly.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <filesets>
                        <fileset><directory>dist</directory></fileset>
                    </filesets>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
