{{!--
  UiList → header (title + action bar) + <ul> of items + optional pagination.
  Parity with renderList() in renderer.ts. Items are nodes of type "item"
  and render through item.hbs, as a partial here because a row is only ever
  drawn by its list.
--}}
<div class="sui-list{{#if cssClass}} {{cssClass}}{{/if}}"{{{events this}}} id="{{id}}">
  <div class="sui-list-header">
    {{#if title}}<h2>{{#if icon}}{{{icon icon}}}{{/if}}{{title}}</h2>{{/if}}
    {{#if headerExtra}}<div class="sui-header-extra">{{{render headerExtra}}}</div>{{/if}}
    <div class="sui-actions"{{#if (eq actionsOverflow "MENU")}} data-sui-overflow="menu" data-sui-overflow-items=":not(.sui-link)"{{/if}}>{{#each actions}}{{> action this}}{{/each}}</div>
  </div>
  <ul>{{#each items}}{{> item this}}{{/each}}</ul>
  {{#if pagination}}{{> pagination pagination}}{{/if}}
</div>
