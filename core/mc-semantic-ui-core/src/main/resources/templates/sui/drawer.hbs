{{!--
  UiDrawer → a panel that slides in from an edge, with a handle for when it is
  minimized. Mirror of renderDrawer() in renderers/drawer.ts. Open, minimized
  and closed are classes on the one element: the browser switches between them
  without redrawing the content. The sizes are CSS lengths (UiDrawer refuses
  anything else), so they go into the style as they are.
--}}
<div class="sui-drawer sui-drawer--{{lower edge "RIGHT"}} sui-drawer--{{lower state "OPEN"}} sui-drawer--{{lower scope "VIEWPORT"}} sui-drawer--{{lower mode "OVERLAY"}}{{#if resizable}} sui-drawer--resizable{{/if}}{{#if cssClass}} {{cssClass}}{{/if}}" id="{{id}}" data-sui="drawer" data-state="{{lower state "OPEN"}}"{{#if onStateChange}} data-state-trigger='{{{trigger onStateChange}}}'{{/if}}{{#if onClose}} data-close-trigger='{{{trigger onClose}}}'{{/if}}{{#if (or size minSize maxSize)}} style="{{#if size}}--sui-drawer-size:{{size}};{{/if}}{{#if minSize}}--sui-drawer-min:{{minSize}};{{/if}}{{#if maxSize}}--sui-drawer-max:{{maxSize}};{{/if}}"{{/if}}><button type="button" class="sui-drawer-handle" data-sui-drawer="open" aria-controls="{{id}}__panel" aria-expanded="{{#if (eq (lower state "OPEN") "open")}}true{{else}}false{{/if}}">{{#if icon}}<span class="sui-drawer-icon">{{{icon icon}}}</span>{{/if}}<span class="sui-drawer-title">{{title}}</span>{{#if badge}}<span class="sui-drawer-badge">{{badge}}</span>{{/if}}</button><div class="sui-drawer-panel" id="{{id}}__panel" role="region" aria-label="{{title}}" tabindex="-1"><div class="sui-drawer-header">{{#if icon}}<span class="sui-drawer-icon">{{{icon icon}}}</span>{{/if}}<span class="sui-drawer-title">{{title}}</span><button type="button" class="sui-drawer-btn" data-sui-drawer="minimize" aria-label="Minimize" title="Minimize">{{{icon "minus"}}}</button>{{#if closable}}<button type="button" class="sui-drawer-btn" data-sui-drawer="close" aria-label="Close" title="Close">{{{icon "x"}}}</button>{{/if}}</div><div class="sui-drawer-body">{{#if content}}{{{render content}}}{{/if}}</div>{{#if resizable}}<div class="sui-drawer-resize" data-sui-drawer="resize" role="separator" aria-orientation="{{#if (or (eq edge "TOP") (eq edge "BOTTOM"))}}horizontal{{else}}vertical{{/if}}" aria-label="Resize"></div>{{/if}}</div></div>
