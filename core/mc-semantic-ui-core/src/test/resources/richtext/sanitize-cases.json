[
  {"name":"formatting kept","in":"<p>Hi <b>there</b> <i>x</i> <u>u</u></p><ul><li>one</li></ul><blockquote>q</blockquote>","out":"<p>Hi <b>there</b> <i>x</i> <u>u</u></p><ul><li>one</li></ul><blockquote>q</blockquote>"},
  {"name":"script dropped with its content","in":"<p>a</p><script>alert(1)</script><p>b</p>","out":"<p>a</p><p>b</p>"},
  {"name":"event handler dropped, image without a safe source removed","in":"<img src=\"x\" onerror=\"alert(1)\">","out":""},
  {"name":"embedded image kept, handler dropped","in":"<img src=\"data:image/png;base64,iVBOR\" alt=\"a\" width=\"40\" onload=\"x()\">","out":"<img src=\"data:image/png;base64,iVBOR\" alt=\"a\" width=\"40\">"},
  {"name":"javascript link unwrapped","in":"<a href=\"javascript:alert(1)\">x</a>","out":"x"},
  {"name":"tab reference inside the scheme","in":"<a href=\"jav&#9;ascript:alert(1)\">x</a>","out":"x"},
  {"name":"raw tab and newline inside the scheme","in":"<a href=\"java\tscr\nipt:alert(1)\">x</a>","out":"x"},
  {"name":"numeric reference spells the scheme","in":"<a href=\"&#106;avascript:alert(1)\">x</a>","out":"x"},
  {"name":"hex references without semicolon","in":"<a href=\"&#x6A;avascript&#x3A;alert(1)\">x</a>","out":"x"},
  {"name":"named colon spells the scheme","in":"<a href=\"javascript&colon;alert(1)\">x</a>","out":"x"},
  {"name":"leading control character","in":"<a href=\"\u0001javascript:alert(1)\">x</a>","out":"x"},
  {"name":"vbscript and data links","in":"<a href=\"vbscript:x\">v</a><a href=\"data:text/html,x\">d</a>","out":"vd"},
  {"name":"good link keeps only href, query escaped","in":"<a href=\"https://ex.com/?a=1&b=2\" target=\"_blank\" onclick=\"x()\">x</a>","out":"<a href=\"https://ex.com/?a=1&amp;b=2\">x</a>"},
  {"name":"relative and mail links kept","in":"<a href=\"/docs\">r</a> <a href=\"mailto:a@b.c\">m</a>","out":"<a href=\"/docs\">r</a> <a href=\"mailto:a@b.c\">m</a>"},
  {"name":"svg dropped with its content","in":"<svg onload=\"alert(1)\"><circle/><text>t</text></svg><p>ok</p>","out":"<p>ok</p>"},
  {"name":"style element and attributes dropped","in":"<style>p{color:red}</style><p style=\"color:red\" class=\"x\">t</p>","out":"<p>t</p>"},
  {"name":"unknown tags unwrapped","in":"<table><tr><td>cell</td></tr></table>","out":"cell"},
  {"name":"text escaped, entities kept","in":"a < b && c > d &amp; e &copy;","out":"a &lt; b &amp;&amp; c &gt; d &amp; e &copy;"},
  {"name":"comment and doctype dropped","in":"<!-- x --><!doctype html><p>y</p>","out":"<p>y</p>"},
  {"name":"unterminated tag becomes text","in":"<a href=\"x","out":"&lt;a href=\"x"},
  {"name":"mixed case","in":"<ScRiPt>alert(1)</sCrIpT><B>b</B>","out":"<b>b</b>"},
  {"name":"svg data image dropped","in":"<img src=\"data:image/svg+xml;base64,PHN2Zz4=\">","out":""},
  {"name":"script split around a removed element","in":"<scr<script></script>ipt>alert(1)</script>","out":"alert(1)"},
  {"name":"office markup unwrapped","in":"<p class=MsoNormal>Hi<o:p></o:p></p>","out":"<p>Hi</p>"},
  {"name":"http image kept","in":"<img src=\"https://ex.com/a.png\" alt=\"pic\">","out":"<img src=\"https://ex.com/a.png\" alt=\"pic\">"},
  {"name":"anchor without href unwrapped, its close dropped","in":"<a name=\"x\">t</a> <a href=\"/y\">u</a>","out":"t <a href=\"/y\">u</a>"},
  {"name":"self-closing break and rule","in":"line<br/>two<hr/>","out":"line<br>two<hr>"},
  {"name":"iframe and form dropped","in":"<iframe src=\"https://ev.il\"></iframe><form action=\"/x\"><input name=\"a\"><button>go</button></form>ok","out":"ok"},
  {"name":"quote in an attribute cannot break out","in":"<a href=\"https://ok\" title=\"&quot;><script>alert(1)</script>\">x</a>","out":"<a href=\"https://ok\">x</a>"},
  {"name":"first of a duplicated attribute wins","in":"<a href=\"/safe\" href=\"javascript:alert(1)\">x</a>","out":"<a href=\"/safe\">x</a>"},
  {"name":"unclosed script eats the rest","in":"<p>a</p><script>alert(1)","out":"<p>a</p>"},
  {"name":"angle bracket in a quoted attribute","in":"<img src=\"https://ex.com/a.png\" alt=\"a > b\">","out":"<img src=\"https://ex.com/a.png\" alt=\"a &gt; b\">"},
